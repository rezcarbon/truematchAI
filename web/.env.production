# TrueMatch Admin Dashboard - Production Environment Configuration
# IMPORTANT: Replace placeholder values with actual production secrets

# ============================================================================
# NextAuth Configuration (Required for authentication)
# ============================================================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-production-secret-here-replace-with-actual-value

# Production URL where admin dashboard is hosted
NEXTAUTH_URL=https://admin.truematch.ai

# ============================================================================
# API Configuration (Backend connectivity)
# ============================================================================
# Production API base URL (accessed by browser through BFF proxy)
NEXT_PUBLIC_API_BASE_URL=/api

# Production backend API endpoint (server-only, never exposed to browser)
BACKEND_API_URL=https://api.truematch.ai/v1

# Service token for BFF proxy to authenticate with backend
# Obtain from your backend deployment
BACKEND_API_TOKEN=your-production-api-token-here

# ============================================================================
# Optional: Monitoring & Analytics
# ============================================================================
# Sentry error tracking (optional)
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ============================================================================
# Next.js Configuration
# ============================================================================
# Disable telemetry in production
NEXT_TELEMETRY_DISABLED=1

# Enable analytics if needed
NEXT_ANALYTICS_ID=
